  "scripts": {
    "generate-manifest": "node generate-manifest.js",
    "start": "env-cmd -f .env react-scripts start",
    "start-eg": "env-cmd -f .env.eg react-scripts start",
    "start-pc": "env-cmd -f .env.pc react-scripts start",
    "build": "env-cmd -f .env npm run generate-manifest -- .env && react-scripts build",
    "build-eg": "env-cmd -f .env.eg npm run generate-manifest -- .env.eg && env-cmd -f .env.eg react-scripts build",
    "build-pc": "env-cmd -f .env.pc npm run generate-manifest -- .env.pc && env-cmd -f .env.pc react-scripts build",
